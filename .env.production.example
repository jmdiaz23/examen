# Plantilla para Render (Postgres). Render inyecta estas variables
# desde el Blueprint render.yaml; aquí quedan documentadas.

APP_NAME=Examenes
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=es
APP_KEY=PON_AQUI_TU_APP_KEY
APP_URL=https://TU-APP.onrender.com

# Render Postgres (valores "Internal" del panel)
DB_CONNECTION=pgsql
DB_HOST=PON_AQUI_HOST_INTERNO
DB_PORT=5432
DB_DATABASE=examen
DB_USERNAME=examen
DB_PASSWORD=PON_AQUI_PASSWORD

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

ADMIN_NAME=Administrador
ADMIN_EMAIL=tu_correo@ejemplo.com
ADMIN_PASSWORD=CAMBIA_ESTO
